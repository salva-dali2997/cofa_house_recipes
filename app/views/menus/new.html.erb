<% content_for :title, "Plan a menu" %>

<h1>Plan a menu</h1>

<%= form_with model: @menu, url: menus_path, method: :post do |form| %>
  <% if form.object.errors.any? %>
    <div class="flash flash-alert">
      <p><%= pluralize(form.object.errors.count, "error") %> prevented this menu from saving:</p>
      <ul>
        <% form.object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :date %>
    <%= form.date_field :date %>
  </div>

  <fieldset>
    <legend>Recipes</legend>

    <% if @recipes.any? %>
      <% @recipes.each do |recipe| %>
        <label class="checkbox-field">
          <%= check_box_tag "menu[recipe_ids][]", recipe.id, @menu.recipe_ids.include?(recipe.id), id: "recipe_#{recipe.id}" %>
          <%= recipe.name %>
        </label>
      <% end %>
    <% else %>
      <p class="empty-state">No recipes yet — <%= link_to "add one", new_recipe_path %> first.</p>
    <% end %>
  </fieldset>

  <div class="actions">
    <%= form.submit "Save today's menu" %>
  </div>
<% end %>

<%= link_to "← Back to today's menu", today_menu_path, class: "link-muted" %>
